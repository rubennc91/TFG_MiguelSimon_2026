<?xml version="1.0" ?>
<!-- (paredes solo de colisión: en los circuitos de entrenamiento no se ven) sil_w80: mapa de audubon_gazebo (Apache-2.0) -> 05_dataset/generador_experto/pista_desde_mapa.py: cinta de asfalto y paredes sobre un suelo plano -->
<sdf version="1.10">
  <world name="default">

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <!-- Test if this works -->
      <camera name="user_camera">
        <track_visual>
          <name>f1</name>
          <static>true</static>
          <use_model_frame>true</use_model_frame>
          <xyz>-1 0 0.25</xyz>
          <inherit_yaw>true</inherit_yaw>
        </track_visual>
      </camera>
    </scene>

    <!-- Circuito -->
    <model name="sil_w80">
      <static>true</static>
      <link name="suelo">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.02 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
      <link name="asfalto">
        <visual name="visual">
          <geometry><mesh><uri>file:///mundos/sil_w80/meshes/asfalto.obj</uri></mesh></geometry>
          <material><ambient>0.05 0.045 0.05 1</ambient><diffuse>0.05 0.045 0.05 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
      <link name="linea">
        <visual name="visual"><geometry><mesh><uri>file:///mundos/sil_w80/meshes/linea.obj</uri></mesh></geometry><material><ambient>0.8 0 0 1</ambient><diffuse>0.8 0 0 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
      </link>
      <link name="paredes">
        <collision name="col_izq"><geometry><mesh><uri>file:///mundos/sil_w80/meshes/pared_izq.obj</uri></mesh></geometry></collision>
        <collision name="col_der"><geometry><mesh><uri>file:///mundos/sil_w80/meshes/pared_der.obj</uri></mesh></geometry></collision>
      </link>
    </model>

    <!-- Luz -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

  </world>
</sdf>