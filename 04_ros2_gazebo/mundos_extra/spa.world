<?xml version="1.0" ?>
<!-- spa: malla de JdeRobot aplanada (05_dataset/generador_experto/aplanar_malla.py): asfalto en z=0 sobre un suelo plano de colisión; sin paredes -->
<sdf version="1.10">
  <world name="default">

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <!-- Test if this works -->
      <camera name="user_camera">
        <track_visual>
          <name>f1</name>
          <static>true</static>
          <use_model_frame>true</use_model_frame>
          <xyz>-1 0 0.25</xyz>
          <inherit_yaw>true</inherit_yaw>
        </track_visual>
      </camera>
    </scene>

    <!-- Circuito -->
    <model name="spa">
      <static>true</static>
      <link name="mapa">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>4000 4000</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><mesh><uri>file:///mundos/spa/meshes/spa_plano.dae</uri></mesh></geometry>
        </visual>
      </link>
    </model>

    <!-- Luz -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

  </world>
</sdf>